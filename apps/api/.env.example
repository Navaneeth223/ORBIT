# Node environment: development, production, or test
NODE_ENV=development

# Server port
PORT=4000

# Frontend URL for CORS
PUBLIC_WEB_ORIGIN=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/orbit

# Redis connection string (for sessions, caching, rate limiting)
REDIS_URL=redis://localhost:6379

# JWT access token secret (CHANGE IN PRODUCTION)
JWT_ACCESS_SECRET=change-me-in-production-use-at-least-32-random-characters

# JWT refresh token secret (CHANGE IN PRODUCTION)
JWT_REFRESH_SECRET=change-me-in-production-use-at-least-32-random-characters

# Cookie signing secret (CHANGE IN PRODUCTION)
COOKIE_SECRET=change-me-in-production-use-at-least-32-random-characters

# Maximum number of users allowed (2 for this private app)
MAX_USERS=2
